{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WeatherApi": {
    "ApiKey": "local-dev-key",
    "MaxItems": 5
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "InstanceName": "MyApp_"
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092"
  }
}
